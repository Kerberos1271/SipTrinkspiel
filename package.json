{
  "name": "sip-party-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:cf",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:cf": "npm run build && wrangler pages dev dist --d1 DB=sip-db --local",
    "deploy": "npm run build && wrangler pages deploy dist --project-name siptrinkspiel"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "wrangler": "latest"
  }
}
